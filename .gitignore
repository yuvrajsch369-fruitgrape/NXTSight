# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Virtual environments
venv/
env/
.venv/
ENV/

# Environment / secrets
.env
.env.local

# Distribution / packaging
build/
dist/
*.egg-info/

# Model artifacts (large binaries — track via releases or LFS, not plain git).
# Small, task-specific classifier artifacts under src/*/artifacts/ (KBs, not
# MBs) are NOT covered by this and stay committed as real evidence — only
# the general-purpose model weights under models/ (tens of MBs) are excluded.
models/**/*.onnx
models/**/*.data
models/**/*.bin
models/**/*.pt
models/**/*.qnn
models/**/*.zip
models/*.onnx
models/*.bin
models/*.pt
models/*.qnn
!models/.gitkeep

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
